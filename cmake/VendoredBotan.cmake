# One pinned static runtime provider in both existing dependency modes.
set(GW_BOTAN_ROOT "${CMAKE_CURRENT_SOURCE_DIR}/third_party/botan")
file(READ "${GW_BOTAN_ROOT}/pins.json" GW_BOTAN_PINS)
string(JSON GW_BOTAN_VERSION GET "${GW_BOTAN_PINS}" version)
if(NOT GW_BOTAN_VERSION STREQUAL "3.13.0")
    message(FATAL_ERROR "Unreviewed Botan version; update the provider ADR and validation first")
endif()
set(GW_BOTAN_SOURCE_SHA "12f5a8358890bbee82edfe9d2e7769b0a610b6dd0e0698aea13d20a675d84620")
file(SHA256 "${GW_BOTAN_ROOT}/Botan-3.13.0.tar.xz" GW_BOTAN_ACTUAL)
if(NOT GW_BOTAN_ACTUAL STREQUAL GW_BOTAN_SOURCE_SHA)
    message(FATAL_ERROR "Bundled Botan source SHA-256 mismatch")
endif()
if(WIN32 AND MSVC AND CMAKE_SIZEOF_VOID_P EQUAL 8)
    set(GW_BOTAN_OS windows)
elseif(APPLE AND CMAKE_SYSTEM_NAME STREQUAL "Darwin" AND CMAKE_SIZEOF_VOID_P EQUAL 8)
    set(GW_BOTAN_OS macos)
elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND CMAKE_SIZEOF_VOID_P EQUAL 8)
    set(GW_BOTAN_OS linux)
else()
    message(FATAL_ERROR "A03 Botan integration targets 64-bit MSVC Windows, Linux and macOS only")
endif()
foreach(file IN ITEMS botan_all.h botan_all.cpp)
    string(JSON expected GET "${GW_BOTAN_PINS}" generated_sha256 "${GW_BOTAN_OS}/${file}")
    file(SHA256 "${GW_BOTAN_ROOT}/${GW_BOTAN_OS}/${file}" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Bundled Botan ${GW_BOTAN_OS}/${file} SHA-256 mismatch")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
                 "${GW_BOTAN_ROOT}/${GW_BOTAN_OS}/${file}")
endforeach()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${GW_BOTAN_ROOT}/pins.json")
add_library(ghostwire_botan STATIC "${GW_BOTAN_ROOT}/${GW_BOTAN_OS}/botan_all.cpp")
target_compile_features(ghostwire_botan PUBLIC cxx_std_20)
target_include_directories(ghostwire_botan SYSTEM PUBLIC "${GW_BOTAN_ROOT}/${GW_BOTAN_OS}")
target_link_libraries(ghostwire_botan PRIVATE Threads::Threads ghostwire_sanitizers)
# Upstream-generated code keeps its own warning set. GhostWire's /W4 /WX and
# -Wall -Wextra -Wpedantic -Wconversion -Wshadow -Werror remain on every owned target.
if(MSVC)
    target_compile_options(ghostwire_botan PRIVATE /W4 /utf-8 /Zc:preprocessor /Zc:__cplusplus /EHsc /bigobj)
    target_compile_options(ghostwire_botan INTERFACE /Zc:preprocessor)
    target_link_libraries(ghostwire_botan PRIVATE bcrypt)
else()
    target_compile_options(ghostwire_botan PRIVATE -Wall -Wextra -fstack-protector-strong)
endif()
message(STATUS "Crypto provider: Botan ${GW_BOTAN_VERSION}, pinned static portable ${GW_BOTAN_OS} subset")
