add_library(ghostwire_options INTERFACE)
if(MSVC)
    target_compile_options(ghostwire_options INTERFACE /W4 /permissive- /utf-8 /Zc:__cplusplus /EHsc)
    if(GW_WARNINGS_AS_ERRORS)
        target_compile_options(ghostwire_options INTERFACE /WX)
    endif()
else()
    target_compile_options(ghostwire_options INTERFACE -Wall -Wextra -Wpedantic -Wconversion -Wshadow)
    if(GW_WARNINGS_AS_ERRORS)
        target_compile_options(ghostwire_options INTERFACE -Werror)
    endif()
endif()
if(GW_ENABLE_SANITIZERS)
    if(CMAKE_CXX_COMPILER_ID MATCHES "^(GNU|Clang|AppleClang)$" AND NOT MSVC)
        target_compile_options(ghostwire_options INTERFACE -fsanitize=address,undefined -fno-omit-frame-pointer)
        target_link_options(ghostwire_options INTERFACE -fsanitize=address,undefined)
    else()
        message(FATAL_ERROR "This sanitizer preset requires GCC or Clang with ASan/UBSan; MSVC sanitizer validation is separate.")
    endif()
endif()
