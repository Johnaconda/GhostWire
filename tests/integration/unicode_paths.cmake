if(NOT DEFINED EXE OR NOT DEFINED WORK OR NOT DEFINED ROLE)
    message(FATAL_ERROR "Missing Unicode test inputs")
endif()
# No shell or TEMP/TMP override: exercise native argv on Windows and UTF-8 config.
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run_id)
set(profile "${WORK}/profile-${run_id}/Users/Jörg Owner/AppData/Local/Temp")
set(root "${profile}/configured data ö")
set(override "${profile}/override data ö")
set(config "${profile}/settings ö.conf")
file(MAKE_DIRECTORY "${profile}")
file(WRITE "${config}" "data_root=${root}\n")

function(check_exit expected)
    execute_process(COMMAND "${EXE}" ${ARGN}
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors
        ENCODING UTF-8 TIMEOUT 10)
    if(NOT "${status}" STREQUAL "${expected}")
        message(FATAL_ERROR "Unicode CLI operation expected exit ${expected}, got ${status}")
    endif()
    if(errors MATCHES "Jörg|settings ö|configured data|override data|private-marker")
        message(FATAL_ERROR "Private path leaked into ordinary diagnostics")
    endif()
    set(last_output "${output}" PARENT_SCOPE)
endfunction()

check_exit(0 --check-config --config "${config}")
check_exit(0 --print-paths --config "${config}")
string(FIND "${last_output}" "data=${root}/${ROLE}/data" position)
if(position LESS 0 OR EXISTS "${root}")
    message(FATAL_ERROR "Unicode print-paths did not preserve text or unexpectedly wrote directories")
endif()
check_exit(0 --config "${config}" --data-root "${override}")
if(EXISTS "${root}" OR NOT IS_DIRECTORY "${override}/${ROLE}/data")
    message(FATAL_ERROR "Unicode bootstrap/override created incorrect storage")
endif()
check_exit(4 --check-config --config "${profile}/absent ö.conf")
# A raw ANSI-style 0xF6 byte is not valid UTF-8. It must not become accepted.
string(ASCII 246 invalid_byte)
file(WRITE "${config}" "data_root=${root}/private-marker-${invalid_byte}\n")
check_exit(3 --check-config --config "${config}")
if(EXISTS "${root}")
    message(FATAL_ERROR "Invalid UTF-8 config created storage")
endif()
file(REMOVE_RECURSE "${WORK}/profile-${run_id}")
