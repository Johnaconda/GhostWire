if(NOT DEFINED EXE OR NOT DEFINED CASE OR NOT DEFINED WORK OR NOT DEFINED ROLE)
    message(FATAL_ERROR "Missing test inputs")
endif()
file(MAKE_DIRECTORY "${WORK}")
set(expected 0)
set(args "--${CASE}")
if(CASE STREQUAL "unknown")
    set(args "--password=DO_NOT_ECHO_198.51.100.19")
    set(expected 2)
elseif(CASE STREQUAL "invalid-config")
    file(WRITE "${WORK}/bad.conf" "secret_token=DO_NOT_ECHO_198.51.100.19\n")
    set(args --check-config --config "${WORK}/bad.conf")
    set(expected 3)
elseif(CASE STREQUAL "missing-config")
    set(args --check-config --config "${WORK}/absent.conf")
    set(expected 4)
elseif(CASE STREQUAL "bootstrap")
    set(args --data-root "${WORK}/application")
elseif(CASE STREQUAL "check-config")
    set(args --check-config --data-root "${WORK}/must-not-be-created")
endif()
execute_process(COMMAND "${EXE}" ${args} RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 10)
if(NOT "${status}" STREQUAL "${expected}")
    message(FATAL_ERROR "Expected exit ${expected}, got ${status}. Output: ${output}; error: ${errors}")
endif()
if("${output}${errors}" MATCHES "DO_NOT_ECHO|198\\.51\\.100\\.19")
    message(FATAL_ERROR "Sensitive input leaked into output")
endif()
if(CASE STREQUAL "version" AND NOT output MATCHES "GW-A01-HF01-WINDOWS-UNICODE-RECOVERY.*${ROLE}")
    message(FATAL_ERROR "Wrong executable version identity")
elseif(CASE STREQUAL "help" AND NOT output MATCHES "ghostwire-${ROLE}")
    message(FATAL_ERROR "Missing help identity")
elseif(CASE STREQUAL "check-config" AND EXISTS "${WORK}/must-not-be-created")
    message(FATAL_ERROR "Config validation unexpectedly created directories")
elseif(CASE STREQUAL "bootstrap")
    if(NOT EXISTS "${WORK}/application/${ROLE}/data" OR NOT errors MATCHES "shutdown")
        message(FATAL_ERROR "Bootstrap did not initialize and stop")
    endif()
    if(NOT output MATCHES "no live networking or encryption implemented")
        message(FATAL_ERROR "Bootstrap must disclose its limited capability")
    endif()
endif()
